---
import { paintingSources } from '../lib/site';

interface Props {
  /** Manifest key: project slug, or `craft-<id>`. */
  id: string;
  alt: string;
  /** Rendered width hint for `sizes`. */
  sizes?: string;
  /** Above the fold → eager + high priority; otherwise lazy. */
  priority?: boolean;
  square?: boolean;
  /** Name the slug so the gallery's view-transition script can find it. */
  slug?: string;
}
const { id, alt, sizes = '(min-width: 56rem) 24rem, 90vw', priority = false, square = false, slug } = Astro.props;
const src = paintingSources(id);
---

{
  src ? (
    <picture class:list={['canvas', square && 'canvas--square']}>
      <source type="image/avif" srcset={src.avif} sizes={sizes} />
      <source type="image/webp" srcset={src.webp} sizes={sizes} />
      <img
        src={src.src}
        alt={alt}
        width={src.width}
        height={src.height}
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={priority ? 'high' : 'auto'}
        data-painting={slug}
      />
    </picture>
  ) : (
    <div class="canvas canvas--unpainted" role="img" aria-label={alt} data-painting={slug}>
      <span aria-hidden="true">Awaiting the painter</span>
    </div>
  )
}
