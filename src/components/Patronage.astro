---
import Icon, { type IconName } from './Icon.astro';
import ContactForm from './ContactForm.astro';
import Scene from './edition/Scene.astro';
import { site, edition, whatsappUrl, mailtoUrl, known } from '../lib/site';

const booking = known(site.contact.booking);
const cv = known(site.cv);
const channels: { icon: IconName; title: string; detail: string; href: string; external?: boolean }[] = [
  ...(booking ? [{ icon: 'calendar' as const, title: 'Book a call', detail: 'Pick a time on Calendly', href: booking, external: true }] : []),
  { icon: 'whatsapp', title: 'WhatsApp', detail: `+${site.contact.whatsapp.replace(/^(\d{2})(\d{2})(\d{3})(\d{4})$/, '$1 $2 $3 $4')}`, href: whatsappUrl(), external: true },
  { icon: 'mail', title: 'Email', detail: site.contact.email, href: mailtoUrl() },
  { icon: 'linkedin', title: 'LinkedIn', detail: 'in/ntsika-gqiba', href: site.social.linkedin, external: true },
  { icon: 'github', title: 'GitHub', detail: 'Zanemvula', href: site.social.github, external: true },
  ...(cv ? [{ icon: 'scroll' as const, title: 'Curriculum vitae', detail: 'PDF', href: cv, external: true }] : []),
];
---

<section class="patronage on-dark" id="patronage" aria-labelledby="patronage-title" data-finale>
  <div class="patronage__scene" aria-hidden="true">
    <Scene id="finale" scene={edition.finale} class="finale__scene" />
    <div class="patronage__veil"></div>
  </div>
  <div class="wrap patronage__inner">
    <div class="section-head">
      <p class="eyebrow">Patronage</p>
      <h2 id="patronage-title">Commission the next work</h2>
      <p>{site.availability}</p>
    </div>
    <div class="patronage__grid">
      <ul class="channels">
        {
          channels.map((c) => (
            <li>
              <a class="channel" href={c.href} {...(c.external ? { rel: 'noopener', target: '_blank' } : {})}>
                <Icon name={c.icon} />
                <span>
                  <strong>{c.title}</strong>
                  <span>{c.detail}</span>
                </span>
                <span class="channel__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
      <ContactForm />
    </div>
  </div>
</section>
