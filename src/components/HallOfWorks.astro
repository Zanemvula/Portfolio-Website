---
import type { CollectionEntry } from 'astro:content';
import Frame from './Frame.astro';
import Painting from './Painting.astro';
import Plaque from './Plaque.astro';
import { known, roman, CLOUD_LABELS } from '../lib/site';

interface Props {
  works: CollectionEntry<'projects'>[];
}
const { works } = Astro.props;

const plaqueMeta = (w: CollectionEntry<'projects'>) => {
  const year = known(w.data.year);
  const clouds = w.data.clouds.map((c) => CLOUD_LABELS[c]).join(' · ');
  const stack = w.data.stack.filter((s) => !clouds.includes(s)).slice(0, 3).join(' · ');
  return [[year, clouds].filter(Boolean).join(' — '), stack];
};
---

<section class="hall on-dark" id="works" aria-labelledby="works-title" data-hall>
  <div class="wrap section-head">
    <p class="eyebrow">Gallery I</p>
    <h2 id="works-title">The Hall of Works</h2>
    <p>Each canvas is a system I built or run. Step closer, then step inside.</p>
  </div>
  <ol class="hall__track" data-hall-track>
    {
      works.map((w) => (
        <li class="work" data-reveal>
          <a class="work__link" href={`/works/${w.id}/`} data-slug={w.id}>
            <Frame>
              <Painting id={w.id} alt={w.data.painting.alt} slug={w.id} />
            </Frame>
            <Plaque no={roman(w.data.order)} title={w.data.title} meta={plaqueMeta(w)} />
            <span class="work__enter">Enter the room →</span>
          </a>
        </li>
      ))
    }
  </ol>
  <p class="hall__catalogue">
    <a class="btn btn--ghost" href="/works/">Read the plain catalogue</a>
  </p>
</section>
