---
import Icon from './Icon.astro';
import { site, whatsappUrl, known } from '../lib/site';
const booking = known(site.contact.booking);
---

<section class="hero on-dark" aria-labelledby="hero-title">
  <div class="hero__vault" aria-hidden="true"></div>
  <div class="wrap hero__inner">
    <p class="hero__kicker">The Gallery of</p>
    <h1 class="hero__name" id="hero-title">{site.name}</h1>
    <p class="hero__headline">
      {site.headline.split(' — ').map((part, i) => <span>{i > 0 && <span class="visually-hidden"> — </span>}{part}</span>)}
    </p>
    <svg class="hero__rule" viewBox="0 0 240 12" aria-hidden="true" focusable="false">
      <path d="M0 6h100M140 6h100" stroke="currentColor" stroke-width="1" />
      <path d="M120 0l6 6-6 6-6-6z" fill="currentColor" />
      <circle cx="104" cy="6" r="2" fill="currentColor" />
      <circle cx="136" cy="6" r="2" fill="currentColor" />
    </svg>
    <p class="hero__value">{site.valueStatement}</p>
    <div class="cta-row">
      {
        booking && (
          <a class="btn btn--gilt" href={booking} rel="noopener" target="_blank">
            <Icon name="calendar" /> Book a call
          </a>
        )
      }
      <a class="btn btn--ghost" href={whatsappUrl()} rel="noopener" target="_blank">
        <Icon name="whatsapp" /> WhatsApp
      </a>
      <a class="btn btn--ghost" href="#works">View work <Icon name="arrow" /></a>
    </div>
  </div>
  <a class="hero__cue" href="#works">Enter the hall</a>
</section>
