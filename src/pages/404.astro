---
import Base from '../layouts/Base.astro';
---

<Base title="Room not found" noindex>
  <div class="lost on-dark">
    <div>
      <p class="eyebrow">Error 404</p>
      <h1>This room is not on the map</h1>
      <p>The painting may have moved to another wall.</p>
      <p><a class="btn btn--gilt" href="/">Return to the gallery</a></p>
    </div>
  </div>
</Base>
