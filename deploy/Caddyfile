# Static file server for the Gallery on Cloud Run.
# TLS terminates at Google's front end, so Caddy only speaks plain HTTP on $PORT.
{
	admin off
	auto_https off
	persist_config off
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	root * /srv

	# Pre-compressed .br/.gz siblings are written at build time.
	file_server {
		precompressed br gzip
	}
	encode {
		gzip 6
		minimum_length 512
	}

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://storage.googleapis.com; font-src 'self'; connect-src 'self' https://formspree.io; media-src 'self' https://storage.googleapis.com; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	# Hashed build assets never change.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# HTML and other un-hashed files: short cache so deploys show up quickly.
	@unhashed not path /_astro/*
	header @unhashed Cache-Control "public, max-age=300, must-revalidate"

	# Cloud Run health checks and uptime probes.
	@health path /healthz
	respond @health "ok" 200

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server {
				precompressed br gzip
			}
		}
	}
}
